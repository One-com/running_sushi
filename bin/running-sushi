require 'chef_diff/repo/git'
require 'chef_diff/changeset'
require 'running_sushi/config'
require 'running_sushi/logging'
require 'running_sushi/hooks'
require 'running_sushi/knife'
require 'running_sushi/diff'
require 'running_sushi/reconcile'
require 'chef/config'
require 'optparse'
require 'logger'
require 'json'

# $success, $status_msg, $lockfileh are script-level globals intentionally:
# - $success/$status_msg are set inside `main` but consumed by the `at_exit`
#   handler registered in `setup_config` (before main runs).  A closure over
#   locals would capture the initial nil/false values, not the updated ones.
# - $lockfileh is opened in acquire_lock and must remain reachable for the
#   entire process lifetime; closing it would release the flock.  The script
#   top-level has no `self` to store state on, so a global is the only option.
# rubocop:disable Style/GlobalVars

$success = false
$status_msg = 'NO WORK DONE'
$lockfileh = nil

def action(msg)
  if RunningSushi::Config.dry_run
    RunningSushi::Log.warn("[DRYRUN] Would do: #{msg}")
  else
    RunningSushi::Log.warn(msg)
  end
end

def acquire_lock
  RunningSushi::Log.warn('Attempting to acquire lock')
  $lockfileh = File.open(RunningSushi::Config.lockfile,
                         File::RDWR | File::CREAT, 0o600)
  $lockfileh.flock(File::LOCK_EX)
  RunningSushi::Log.warn('Lock acquired')
end

def write_pidfile
  File.write(RunningSushi::Config.pidfile, Process.pid)
end

def delete_pidfile
  FileUtils.rm_f(RunningSushi::Config.pidfile)
end

def checkpoint_path
  File.join(RunningSushi::Config.master_path,
            RunningSushi::Config.rev_checkpoint)
end

def write_checkpoint(rev)
  File.write(checkpoint_path, rev) unless RunningSushi::Config.dry_run
end

def read_checkpoint
  RunningSushi::Log.debug("Reading #{checkpoint_path}")
  File.exist?(checkpoint_path) ? File.read(checkpoint_path).strip : nil
end

def node_checkpoint_path
  File.join(RunningSushi::Config.master_path,
            RunningSushi::Config.node_checkpoint)
end

def write_node_checkpoint(nodes, rev)
  node_checkpoint = [rev, nodes]
  File.write(node_checkpoint_path, node_checkpoint.to_json) unless RunningSushi::Config.dry_run
end

def read_node_checkpoint
  RunningSushi::Log.debug("Reading #{node_checkpoint_path}")
  return nil, [] unless File.exist?(node_checkpoint_path)

  upload_checkpoint = JSON.parse(File.read(node_checkpoint_path))
  checkpoint = upload_checkpoint[0]
  nodes = upload_checkpoint[1]
  [checkpoint, nodes]
end

def pod_config
  dirs = [
    RunningSushi::Config.node_path,
    RunningSushi::Config.client_path,
    RunningSushi::Config.environment_path,
    RunningSushi::Config.role_local_path
  ]
  return dirs unless RunningSushi::Config.pod_name

  pod = RunningSushi::Config.pod_name.to_s
  dirs.map { |d| File.join(d, pod) }
end

# The diff mode: applies to the Chef Server what changed in Git from
# +checkpoint+ to +local_head+ (RunningSushi::Diff). Logs the plan, which is
# dry-run's report, and fails before any write when a file to upload
# contradicts its path (Knife#check_uploads).
def chef_upload(knife, repo, checkpoint, local_head)
  locations = changeset_locations
  changeset = diff_changeset(repo, checkpoint, local_head, locations)
  plan = RunningSushi::Diff.plan(changeset, lazy_git_tree(repo, locations), knife,
                                 local_roles: local_roles?, extra_nodes: unverified_nodes(knife))
  RunningSushi::Diff.report(plan).each { |line| RunningSushi::Log.warn(line) }

  # Everything above only reads (the diff, the checkout, and the server for
  # node verification and for the cookbook versions to delete); everything
  # below writes to the Chef Server. Dry-run stops here, after the plan has
  # been logged as its report.
  knife.check_uploads(plan.checks)
  action('Applying changes to the Chef Server')
  return if RunningSushi::Config.dry_run

  RunningSushi::Diff.apply(knife, plan, local_head) { |nodes| write_node_checkpoint(nodes, local_head) }
end

# The ChefDiff::Changeset from +checkpoint+ to +local_head+; exits when
# either is not a revision of +repo+.
def diff_changeset(repo, checkpoint, local_head, locations)
  RunningSushi::Log.warn("Determing changes... from #{checkpoint} to #{local_head}")
  ChefDiff::Changeset.new(RunningSushi::Log, repo, checkpoint, local_head, locations)
rescue ChefDiff::Changeset::ReferenceError => e
  RunningSushi::Log.error("Repo error, invalid revision (#{e.message}), exiting")
  exit(2)
end

# The repo-relative directories ChefDiff::Changeset looks for each type in.
# The keys double as RunningSushi::Knife.new options (checkout_knife).
def changeset_locations
  node_dir, client_dir, environment_dir, role_local_dir = pod_config
  {
    cookbook_dirs: RunningSushi::Config.cookbook_paths,
    client_dir: client_dir,
    databag_dir: RunningSushi::Config.databag_path,
    environment_dir: environment_dir,
    node_dir: node_dir,
    role_local_dir: role_local_dir,
    role_dir: RunningSushi::Config.role_path
  }
end

# A ChefDiff::Changeset of every tracked file under +locations+, each a
# :modified change: a nil start revision lists the tree instead of a diff.
def git_tree(repo, locations)
  ChefDiff::Changeset.new(RunningSushi::Log, repo, nil, nil, locations)
end

# A lambda returning git_tree, listed on first call only, so a diff touching
# no role, node, client, environment or deleted cookbook never lists the
# tree.
def lazy_git_tree(repo, locations)
  listing = nil
  -> { listing ||= git_tree(repo, locations) }
end

# The names of the nodes the last run uploaded whose checkpoint stamp on the
# Chef Server is not that run's revision, so they are uploaded again.
#
# This works around a Chef race: a chef-client run that started before the
# upload saves its node back at the end and overwrites the new content.
# The nodes are re-queued by name (see Diff.named_changes), so a node moved
# since is uploaded from where its file is now, and one with no file in the
# tracked tree is skipped.
def unverified_nodes(knife)
  checkpoint, nodes = read_node_checkpoint
  return [] unless checkpoint

  nodes.map { |node| File.basename(node) }.reject { |name| knife.verify_node_upload(name, checkpoint) }
end

# Whether local roles count, on the diff path and in reconcile alike. A local
# role overrides a global one for a single pod (roles_local/<pod_name>/).
# Without pod_name the server tracks every pod, and one Chef role serves all
# their nodes, so a pod's override would leak to every other pod; there the
# local tree is ignored and every role comes from the global one.
#
# Same truthiness test as pod_config: a pod_name that pod_config treats as
# absent (false) must not turn local roles on, or the whole roles_local tree
# would count.
def local_roles?
  RunningSushi::Config.pod_name ? true : false
end

def upload_changed(repo, checkpoint)
  local_head = repo.head_rev
  chef_upload(checkout_knife, repo, checkpoint, local_head)
  local_head
end

# Compares the working tree with the Chef Server, logs the drift and, unless
# in dry-run, fixes it (RunningSushi::Reconcile).
#
# When HEAD is not the checkpoint, the tree holds commits never applied,
# which a compare counts as drift; that is warned about. A real run never
# gets here in that state: its diff step has just moved the checkpoint to
# HEAD. A dry run does, since it neither updates the repo nor writes the
# checkpoint: after a failed real run, a pull by hand, or on a pod without a
# checkpoint yet. It still compares then, as it writes nothing and skipping
# would leave exactly those pods without a report; the warning says the
# report then lists everything a real run would change, unapplied commits
# included. A real run keeps refusing, so it never "fixes" unapplied commits.
def reconcile(repo)
  dry_run = RunningSushi::Config.dry_run
  warning = unapplied_head_warning(repo.head_rev, read_checkpoint, dry_run: dry_run)
  RunningSushi::Log.warn(warning) if warning
  return if warning && !dry_run

  knife = checkout_knife
  checks = compare_drift(repo, knife)

  action('Reconciling the Chef Server with Git')
  return if dry_run

  rev = repo.head_rev
  RunningSushi::Reconcile.apply(knife, checks, rev) { |nodes| add_node_checkpoint(nodes, rev) }
end

# Compares every file in Git with the server and logs the drift; returns
# the RunningSushi::Reconcile::Checks.
def compare_drift(repo, knife)
  locations = changeset_locations
  RunningSushi::Reconcile.compare(knife, git_tree(repo, locations), RunningSushi::Log, locations,
                                  local_roles: local_roles?, types: reconcile_types)
end

# Adds +nodes+ to those the next run verifies (see unverified_nodes). The
# ones already recorded are kept only when recorded for +rev+: older ones
# carry an older stamp and would all fail verification against +rev+.
def add_node_checkpoint(nodes, rev)
  recorded_rev, recorded = read_node_checkpoint
  write_node_checkpoint((recorded_rev == rev ? recorded : []) + nodes, rev)
end

# The RunningSushi::Reconcile::TYPES keys a reconcile compares: all of them
# when the reconcile setting is true, else the ones it lists (from
# --reconcile=TYPES, or the config file as strings or symbols).
def reconcile_types
  setting = RunningSushi::Config.reconcile
  setting == true ? RunningSushi::Reconcile::TYPES.keys : Array(setting).map(&:to_sym).uniq
end

def reconcile_type_names
  RunningSushi::Reconcile::TYPES.keys.join(',')
end

# Exits 2 when the reconcile setting names a type reconcile doesn't know,
# or an empty list (which would reconcile nothing while looking enabled),
# before the run takes the lock or changes anything.
def check_reconcile_types
  return unless RunningSushi::Config.reconcile

  unknown = reconcile_types - RunningSushi::Reconcile::TYPES.keys
  error = if reconcile_types.empty? then 'No reconcile types given'
          elsif unknown.any? then "Unknown reconcile types: #{unknown.join(',')}"
          end
  return unless error

  RunningSushi::Log.error("#{error}; known: #{reconcile_type_names}")
  exit(2)
end

# The reconcile warning for a +head+ that is not the +checkpoint+ (nil
# when there is none yet); nil when +head+ is the checkpoint.
def unapplied_head_warning(head, checkpoint, dry_run:)
  return if head == checkpoint

  applied = checkpoint ? "checkpoint #{checkpoint}" : 'no checkpoint yet'
  return "Reconcile: skipped, HEAD #{head} is not applied yet (#{applied})" unless dry_run

  "Reconcile: HEAD #{head} is not applied yet (#{applied}), so the report counts its unapplied commits as drift"
end

# A Knife reading the same directories as the changeset (changeset_locations),
# made absolute under the checkout.
def checkout_knife
  base_dir = File.join(RunningSushi::Config.master_path, RunningSushi::Config.reponame)
  dirs = changeset_locations.transform_values do |dir|
    dir.is_a?(Array) ? dir.map { |d| File.join(base_dir, d) } : File.join(base_dir, dir)
  end
  RunningSushi::Knife.new(dirs.merge(logger: RunningSushi::Log, master_path: RunningSushi::Config.master_path,
                                     base_dir: base_dir))
end

# OptionParser must enumerate all 8 CLI flags; each option occupies 2-5 lines.
# BlockLength: the OptionParser block is 30 lines (limit 25) — splitting it
# into sub-methods would add no clarity. The complexity cops count the
# branches inside the option blocks, which are each one flag's parsing.
# rubocop:disable-next Metrics/AbcSize, Metrics/BlockLength, Metrics/MethodLength, Metrics/CyclomaticComplexity, Metrics/PerceivedComplexity
def setup_config
  options = {}
  OptionParser.new do |opts|
    options[:config_file] = RunningSushi::Config.config_file
    opts.on('-n', '--dry-run', 'Dryrun mode') do |s|
      options[:dry_run] = s
    end
    # -r takes no TYPES: an optional argument would read -rn as the type n.
    opts.on('-r', 'Make the Chef Server match Git, for every type') do
      options[:reconcile] = true
    end
    opts.on('--reconcile [TYPES]', Array,
            "Like -r, or only for the comma-separated TYPES (#{reconcile_type_names})") do |s|
      options[:reconcile] = s ? s.map(&:to_sym) : true
    end
    opts.on('-v', '--verbosity', 'Verbosity level. Twice for debug.') do
      # If -vv is supplied this block is executed twice
      options[:verbosity] = if options[:verbosity]
                              Logger::DEBUG
                            else
                              Logger::INFO
                            end
    end
    opts.on('-T', '--timestamp', 'Timestamp output') do |s|
      options[:timestamp] = s
    end
    opts.on('-c', '--config-file FILE', 'config file') do |s|
      unless File.exist?(File.expand_path(s))
        RunningSushi::Log.error("Config file #{s} not found.")
        exit(2)
      end
      options[:config_file] = s
    end
    opts.on('-l', '--lockfile FILE', 'lockfile') do |s|
      options[:lockfile] = s
    end
    opts.on('-p', '--pidfile FILE', 'pidfile') do |s|
      options[:pidfile] = s
    end
  end.parse!
  RunningSushi::Config.from_file(options[:config_file]) if File.exist?(File.expand_path(options[:config_file]))
  RunningSushi::Config.merge!(options)
  RunningSushi::Log.verbosity = RunningSushi::Config.verbosity
  check_reconcile_types
  RunningSushi::Log.warn('Dryrun mode activated, no changes will be made.') if RunningSushi::Config.dry_run
  RunningSushi::Hooks.get(RunningSushi::Config.plugin_path)
  at_exit do
    RunningSushi::Hooks.atexit(RunningSushi::Config.dry_run,
                               $success, $status_msg)
  end

  Chef::Config[:node_name] = RunningSushi::Config.user
  Chef::Config[:client_key] = RunningSushi::Config.pem
  Chef::Config[:chef_server_url] = RunningSushi::Config.chef_server_url
  Chef::Config[:ssl_verify_mode] = RunningSushi::Config.ssl_verify_mode || :verify_peer
end

def fetch_repo
  repo_path = File.join(RunningSushi::Config.master_path,
                        RunningSushi::Config.reponame)
  r = ChefDiff::Repo.get(RunningSushi::Config.vcs_type, repo_path,
                         RunningSushi::Log)
  r.bin = RunningSushi::Config.vcs_path if RunningSushi::Config.vcs_path
  r
end

# Pulls +repo+. ChefDiff raises with git's output but no longer logs it, and
# syslog is where a failed cron run is looked into.
def update_repo(repo)
  repo.update
rescue Mixlib::ShellOut::ShellCommandFailed => e
  RunningSushi::Log.error("Updating the repo failed: #{e.message}")
  raise
end

# Top-level script entry point: all branches (clone vs update, dry-run, no-repo,
# no-change, upload failure) are load-bearing and must remain in one function
# so the control-flow stays readable as a narrative.
# rubocop:disable-next Metrics/AbcSize, Metrics/CyclomaticComplexity, Metrics/MethodLength, Metrics/PerceivedComplexity
def main
  setup_config

  RunningSushi::Hooks.preflight_checks(RunningSushi::Config.dry_run)

  acquire_lock
  write_pidfile
  repo = fetch_repo

  RunningSushi::Hooks.prerun(RunningSushi::Config.dry_run)

  if repo.exists?
    action('Updating repo')
    update_repo(repo) unless RunningSushi::Config.dry_run
  else
    unless RunningSushi::Config.repo_url
      RunningSushi::Log.error(
        'No repo URL was specified, and no repo is checked out'
      )
      exit(1)
    end
    action('Cloning repo')
    repo.checkout(RunningSushi::Config.repo_url) unless RunningSushi::Config.dry_run
  end

  RunningSushi::Hooks.post_repo_up(RunningSushi::Config.dry_run)

  if RunningSushi::Config.dry_run && !repo.exists?
    RunningSushi::Log.warn(
      'In dryrun mode, with no repo, there\'s not much I can dryrun'
    )
    RunningSushi::Hooks.postrun(RunningSushi::Config.dry_run, true,
                                'dryrun mode')
    exit
  end

  checkpoint = read_checkpoint
  _, uploaded_nodes = read_node_checkpoint
  if repo.exists? && repo.head_rev == checkpoint && uploaded_nodes.empty?
    RunningSushi::Log.warn('Repo has not changed and no node uploads to check, nothing to do...')
    $success = true
    $status_msg = "Success at #{checkpoint}"
  else
    begin
      ver = upload_changed(repo, checkpoint)
      write_checkpoint(ver)
      $success = true
      $status_msg = "Success at #{ver}"
    rescue StandardError => e
      $status_msg = e.message
      e.backtrace.each do |line|
        RunningSushi::Log.error(line)
      end
    end
  end

  # After a failed diff step the server is mid-apply, so there is nothing
  # meaningful to compare it with.
  if $success && RunningSushi::Config.reconcile
    begin
      reconcile(repo)
    rescue StandardError => e
      $success = false
      $status_msg = "Reconcile failed: #{e.message}"
      e.backtrace.each do |line|
        RunningSushi::Log.error(line)
      end
    end
  end

  RunningSushi::Log.warn($status_msg)
  RunningSushi::Hooks.postrun(RunningSushi::Config.dry_run, $success,
                              $status_msg)
  delete_pidfile
end

main
# rubocop:enable Style/GlobalVars
